# 家账簿 HomeLedger 环境变量示例
# 复制为 .env 或直接在 docker-compose.yml 中配置

# 服务端口
PORT=5111

# 时区（决定“今天”是哪天，务必按所在地设置）
TZ=Asia/Shanghai

# 会话签名密钥：务必改成随机长字符串（可用 openssl rand -hex 32 生成）
SESSION_SECRET=change-me-to-a-long-random-string

# 数据目录
#   本地源码运行（npm run dev）：用项目内的相对路径，如 ./data
#   Docker 部署：容器内固定为 /data（docker-compose.yml 已指定，不受此文件影响）
#   同时也是 SQLite 数据库文件与账单截图附件的存放位置
DATA_DIR=/data

# ============================================
# 账单截图（附件）存储方式
# ============================================
# local（默认）：存到 DATA_DIR/uploads/，备份时拷 data 目录即可
# s3：存到 S3 兼容对象存储（RustFS / MinIO / AWS S3），
#     用 AWS SDK for JavaScript v3 接入，附件不再占本地磁盘
#
# 注意：Docker 部署时 docker-compose.yml 的 environment 段优先级高于本文件，
#     其中固定了 PORT / HOST / DATA_DIR / TZ；其余变量（含下面的 S3_*）以本文件为准。
STORAGE_DRIVER=local

# ---- 以下为 STORAGE_DRIVER=s3 时的连接参数 ----
# RustFS 默认 S3 API 端口 9000、控制台端口 9001
# 未安装时设置的密钥默认是 rustfsadmin / rustfsadmin（仅限本地试用，务必自行修改）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
# 存储桶名（启动时若不存在会自动创建）
S3_BUCKET=homeledger
# 桶内的对象前缀，便于与其他数据隔离
S3_PREFIX=uploads
# RustFS 默认使用 path-style 访问（虚拟主机风格需额外配置域名，一般不用改）
S3_FORCE_PATH_STYLE=true

# ============================================
# 数据库（三选一：ENABLE=true 的生效；都不启用时默认 SQLite）
# ============================================

# SQLite（默认）：单文件零依赖，数据存于 DATA_DIR
DB_SQLITE_ENABLE=true

# MySQL：需先自建数据库（字符集建议 utf8mb4，保证 emoji 可存）
DB_MYSQL_ENABLE=false
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=homeledger
DB_MYSQL_PASSWORD=change-me
DB_MYSQL_DATABASE=homeledger

# PostgreSQL
DB_POSTGRES_ENABLE=false
DB_POSTGRES_HOST=127.0.0.1
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=homeledger
DB_POSTGRES_PASSWORD=change-me
DB_POSTGRES_DATABASE=homeledger

# 首次启动自动创建的管理员账号（仅在数据库无任何用户时生效）
ADMIN_USER=admin
ADMIN_PASSWORD=admin888

# 是否允许自助注册（true/false）。家庭使用建议 false，由管理员邀请加入
ALLOW_REGISTER=false
