{
  "name": "homeledger",
  "version": "2.0.0",
  "private": true,
  "description": "家账簿 HomeLedger —— 自托管家庭记账系统：全类型记账 + AI 截图/文本自动记账 + 开放 API，前端 Vue 3 SPA，数据自持于 SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings --env-file=.env server.js",
    "dev": "node --no-warnings --env-file=.env --watch server.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1"
  }
}
